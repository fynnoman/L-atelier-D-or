# L'Atelier d'Or — Environment variables

# Basis-URL der Site (fuer metadataBase, sitemap, canonicals, OG-Images, JSON-LD).
# Vor Domain-Kauf: Vercel-URL. Nach Domain-Kauf: https://deine-domain.com
NEXT_PUBLIC_SITE_URL=https://laterlierdor-fynn-schulzs-projects.vercel.app

# ------------------------------------------------------------------
# Kontakt-Formular (ConseilEcrin auf /conseil)
# ------------------------------------------------------------------

# Beispiel Web3Forms (kostenlos, ohne Server):
#   1. https://web3forms.com/ → Access Key holen
#   2. Endpoint auf https://api.web3forms.com/submit setzen
#   3. Access Key hier eintragen
# NEXT_PUBLIC_CONSEIL_ENDPOINT=https://api.web3forms.com/submit
# NEXT_PUBLIC_CONSEIL_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Beispiel Formspree:
# NEXT_PUBLIC_CONSEIL_ENDPOINT=https://formspree.io/f/YOUR-FORM-ID

# Fallback: wenn nur eine E-Mail-Adresse konfiguriert ist und kein Endpoint,
# oeffnet das Formular einen mailto-Link (weniger elegant, kein Empfangs-Beleg).
# NEXT_PUBLIC_CONSEIL_EMAIL=bonjour@deine-domain.com

# ------------------------------------------------------------------
# Newsletter (NewsletterSignup im Footer)
# ------------------------------------------------------------------
# Kompatibel mit Web3Forms, Buttondown, ConvertKit-Landing-JSON etc.
# Beispiel Web3Forms:
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://api.web3forms.com/submit
# NEXT_PUBLIC_NEWSLETTER_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Beispiel Buttondown:
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://buttondown.email/api/emails/embed-subscribe/YOUR-USER
