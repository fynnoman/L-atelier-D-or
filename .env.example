# ————————————————————————————————————————————————————————————
# L'Atelier d'Or — Environment Variables
# Diese Datei ist eine Vorlage. In Vercel: Project Settings → Environment Variables.
# Die Werte hier niemals committen.
# ————————————————————————————————————————————————————————————

# Produktions-Domain (für Canonicals, Sitemap, Welcome-Mail-Links)
NEXT_PUBLIC_SITE_URL="https://laterlierdor.com"

# ———— Resend (Mail-Delivery für alle Formulare) ————
# API-Key aus https://resend.com/api-keys
RESEND_API_KEY=""

# Verifizierter Absender. Die Domain muss in Resend unter DNS verifiziert sein.
# Beispiel: "L'Atelier d'Or <info@laterlierdor.com>"
CONTACT_FROM_EMAIL="L'Atelier d'Or <info@laterlierdor.com>"

# Empfänger-Postfach für Conseil- und Avis-Submissions sowie für interne
# Benachrichtigungen bei Newsletter-Anmeldungen.
CONTACT_TO_EMAIL="info@laterlierdor.com"

# Optional: Resend-Audience, falls Newsletter-Abonnenten dort gesammelt werden sollen
# NEWSLETTER_AUDIENCE_ID=""

# ———— Shopify (Review-Followup-Cron) ————
# Shopify Admin API token, gefunden unter:
#   Shopify Admin → Settings → Apps and sales channels → Develop apps →
#   <deine App> → API credentials → Admin API access token
# Scopes nötig: read_orders, write_orders
SHOPIFY_ADMIN_TOKEN=""

# Dein Shopify-Store-Domain, z.B. "shop-latelierdor.myshopify.com".
# Das ist die technische .myshopify.com-Adresse, nicht die Custom-Domain.
SHOPIFY_STORE_DOMAIN=""

# Zufälliger String, sichert den Cron-Endpunkt gegen fremde Aufrufer ab.
# Beliebig lang (empfohlen: 32+ Zeichen).
CRON_SECRET=""

# ———— Fallback für Formulare (nur genutzt wenn Resend nicht konfiguriert) ————
# Wenn gesetzt, öffnen Conseil-/Avis-Form bei Delivery-Fehler einen mailto:-Link.
NEXT_PUBLIC_CONSEIL_EMAIL="info@laterlierdor.com"
NEXT_PUBLIC_FEEDBACK_EMAIL="info@laterlierdor.com"

# ———— SEO-Verification (optional) ————
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_BING_VERIFICATION=""
# NEXT_PUBLIC_AHREFS_VERIFICATION=""
